{
  "name": "video-summarizer-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Host-agent video evidence to grounded HTML, Markdown and PDF",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "overrides": {
    "@steipete/summarize-core": {
      "undici": "8.12.3"
    }
  },
  "dependencies": {
    "@steipete/summarize-core": "0.25.3",
    "ajv": "8.20.0",
    "bgutils-js": "4.0.3",
    "handlebars": "4.7.10",
    "jsdom": "30.1.3",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "playwright-core": "1.64.1",
    "serve-static": "2.2.1",
    "subtitle": "4.2.2"
  }
}
